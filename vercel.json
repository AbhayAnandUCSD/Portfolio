{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/generalintuition",
      "destination": "/bookofworlds/",
      "permanent": true
    },
    {
      "source": "/generalintuition/:path*",
      "destination": "/bookofworlds/:path*",
      "permanent": true
    },
    {
      "source": "/bookofworlds",
      "destination": "/bookofworlds/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/bookofworlds/api/:path*",
      "destination": "https://xppmuy4whv.us-east-1.awsapprunner.com/api/:path*"
    },
    {
      "source": "/bookofworlds/",
      "destination": "https://abhayananducsd.github.io/bookofworlds/index.html"
    },
    {
      "source": "/bookofworlds/:path*",
      "destination": "https://abhayananducsd.github.io/bookofworlds/:path*"
    }
  ]
}
